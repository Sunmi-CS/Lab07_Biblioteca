<Window x:Class="Biblioteca.WPF.Views.SocioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Socio" Height="250" Width="400">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="DNI:" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="txtDNI" Width="200" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Nombre:" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="txtNombre" Width="260" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Email:" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="txtEmail" Width="260" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Aceptar" Width="80" Margin="0,0,8,0" Click="BtnAceptar_Click" />
            <Button Content="Cancelar" Width="80" Click="BtnCancelar_Click" />
        </StackPanel>
    </Grid>
</Window>
